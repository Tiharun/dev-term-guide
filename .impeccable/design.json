      "css": ".ds-act{width:36px;height:36px;display:inline-grid;place-items:center;border-radius:8px;color:#6a7690;border:1px solid transparent;background:none;cursor:pointer}.ds-act svg{width:18px;height:18px;stroke:currentColor;fill:none;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}.ds-act:hover{color:#1d2b4f;border-color:#d3dbe4}.ds-act:focus-visible{outline:2px solid #e0662b;outline-offset:2px}.ds-act[aria-pressed=true]{color:#a8410f}.ds-act[aria-pressed=true] svg{fill:#fdf0e8}"
