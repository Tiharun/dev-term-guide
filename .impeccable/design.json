      "css": ".ds-plate{display:grid;grid-template-columns:minmax(0,1.12fr) minmax(0,1fr);gap:28px;background:#fff;border:1px solid #d3dbe4;border-radius:14px;padding:24px;color:#1d2b4f;font-family:'Malgun Gothic',sans-serif}.ds-fig{position:relative;background:#edf1f5;border-radius:10px;min-height:220px;overflow:hidden;margin:0}.ds-stage{display:grid;place-items:center;min-height:220px;grid-template-columns:minmax(0,1fr)}.ds-node{background:#fff;border:1.5px solid #1d2b4f;border-radius:9px;padding:10px 14px;font-size:14px;font-weight:700;box-shadow:0 2px 6px rgba(15,20,30,.08)}.ds-leaders{position:absolute;inset:0;width:100%;height:100%;pointer-events:none}.ds-leaders line{stroke:#1d2b4f;stroke-width:1.2;vector-effect:non-scaling-stroke}.ds-leaders circle{fill:#e0662b}.ds-lab{position:absolute;transform:translate(-50%,-50%);font-size:12.5px;font-weight:700;background:#fff;border:1px solid #1d2b4f;border-radius:5px;padding:2px 8px;white-space:nowrap}.ds-figcap{position:absolute;left:14px;bottom:11px;font-size:12.5px;color:#4a587a}.ds-figcap b{color:#4d6d40;font-variant-numeric:tabular-nums}.ds-term-en{font-family:Hahmlet,Batang,serif;font-size:27px;font-weight:600;letter-spacing:-.02em;line-height:1.2;margin:0}.ds-term-ko{color:#4a587a;font-size:14.5px;margin:3px 0 12px}.ds-row{display:grid;grid-template-columns:78px 1fr;gap:10px;font-size:15px;padding:9px 0;border-top:1px solid #e6ebf0}.ds-row>b{color:#4d6d40;font-size:13.5px}"
