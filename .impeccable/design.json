      "html": "<div class=\"ds-key\"><button class=\"ds-chip\">흔들린다</button><button class=\"ds-chip\" aria-pressed=\"true\">박스가 흔들림<span class=\"ds-redo\">바꾸기</span></button><a class=\"ds-chip ds-chip-term\" href=\"#\">Layout Shift</a></div>",
      "css": ".ds-key{background:#1d2b4f;padding:18px;border-radius:14px;display:flex;gap:7px;flex-wrap:wrap}.ds-chip{background:#2c3d68;color:#eef2f9;border:1px solid #42568a;border-radius:999px;padding:6px 13px;font-size:14px;cursor:pointer;transition:background .2s,border-color .2s;font-family:'Malgun Gothic',sans-serif;text-decoration:none}.ds-chip:hover{border-color:#8ea2cc;background:#3b4f82}.ds-chip:focus-visible{outline:2px solid #e0662b;outline-offset:2px}.ds-chip[aria-pressed=true]{background:#f6f8f7;color:#1d2b4f;border-color:#f6f8f7;font-weight:700}.ds-redo{margin-left:8px;font-size:12px;font-weight:400;color:#4a587a;text-decoration:underline}.ds-chip-term{background:#e0662b;border-color:#e0662b;color:#fff;font-weight:700}.ds-chip-term:hover{background:#c8551d;border-color:#c8551d}"
