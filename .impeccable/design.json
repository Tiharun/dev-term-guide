      "css": ".ds-key{background:#1d2b4f;padding:18px;border-radius:14px}.ds-search{display:flex;align-items:center;gap:10px;background:#f6f8f7;color:#1d2b4f;border-radius:9px;padding:0 14px;width:min(380px,100%);height:46px}.ds-search input{border:0;background:none;outline:none;flex:1;min-width:0;font:inherit;font-size:15.5px;color:inherit;caret-color:#e0662b}.ds-search input::placeholder{color:#5f6c86}.ds-search:focus-within{outline:2px solid #e0662b;outline-offset:2px}"
